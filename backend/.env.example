# Environment Configuration for Three-Stage RAG Integrity Shield

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration
DATABASE_URL=sqlite:///./data/megaton_shield.db

# LLM Provider Configuration
# Options: deterministic_mock, openai, gemini
LLM_PROVIDER=deterministic_mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Security Thresholds
INJECTION_SENSITIVITY=0.75
ANOMALY_CONTAMINATION=0.1
LEXICAL_STUFFING_THRESHOLD=0.65
SIMILARITY_THRESHOLD=0.35

